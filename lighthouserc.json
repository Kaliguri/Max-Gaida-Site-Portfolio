{
  "ci": {
    "collect": {
      "startServerCommand": "npx serve out -l 4600 --no-clipboard",
      "startServerReadyPattern": "Accepting connections",
      "url": [
        "http://localhost:4600/ru/",
        "http://localhost:4600/ru/resume/unity-developer/",
        "http://localhost:4600/ru/projects/knock-on-the-coffin-lid/",
        "http://localhost:4600/ru/privacy/"
      ],
      "numberOfRuns": 1
    },
    "assert": {
      "assertions": {
        "categories:accessibility": ["error", { "minScore": 1 }],
        "categories:best-practices": ["error", { "minScore": 1 }],
        "categories:seo": ["error", { "minScore": 1 }],
        "categories:performance": ["error", { "minScore": 0.75 }]
      }
    },
    "upload": {
      "target": "temporary-public-storage"
    }
  }
}
